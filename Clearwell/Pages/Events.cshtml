@page
@model Clearwell.Pages.EventsModel
@{ ViewData["Title"] = "Events"; }

<section class="wrap section narrow">
    <h1>Upcoming events</h1>
    <p class="lead">Join us in person. Every event supports our next water point.</p>

    <article class="event">
        <time datetime="2026-12-05"><strong>5</strong> Dec</time>
        <div>
            <h3>Community fun run</h3>
            <p>A 5 km run through the city park. Entry is $10 and every runner gets a water bottle.</p>
            <a class="btn btn-small" href="#">RSVP</a>
        </div>
    </article>
    <article class="event">
        <time datetime="2027-01-16"><strong>16</strong> Jan</time>
        <div>
            <h3>Fundraising dinner</h3>
            <p>An evening of food, music and stories from the schools we have served.</p>
            <a class="btn btn-small" href="#">RSVP</a>
        </div>
    </article>
    <article class="event">
        <time datetime="2027-02-20"><strong>20</strong> Feb</time>
        <div>
            <h3>Volunteer open day</h3>
            <p>Meet the team, see how a water point works, and find a role that suits you.</p>
            <a class="btn btn-small" href="#">RSVP</a>
        </div>
    </article>
</section>
