@page
@model Clearwell.Pages.AboutModel
@{ ViewData["Title"] = "About"; }

<section class="wrap section narrow">
    <h1>About Clearwell</h1>
    <p class="lead">Clearwell started when a group of teachers noticed that pupils were missing lessons to fetch water. We decided to put the water where the children already are.</p>
    <img class="hero-image" src="Images/CarryingWater.jpg" alt="Children carrying water" />
    <h2>Our mission</h2>
    <p>To give every rural school and clinic in our region a safe, reliable water supply that the community can run itself.</p>

    <h2>How we work</h2>
    <p>We only build where a school asks us to. Local labour builds the system, a local committee runs it, and we stay on for five years to make sure it keeps working.</p>

    <h2>Our team</h2>
    <div class="grid">
        <article class="panel"><h3>Jane Doe</h3><p>Director</p></article>
        <article class="panel"><h3>John Doe </h3><p>Programmes lead</p></article>
        <article class="panel"><h3>Tom Doe</h3><p>Field engineer</p></article>
    </div>
</section>
