@page
@model Clearwell.Pages.VolunteerModel
@{ ViewData["Title"] = "Volunteer"; }

<section class="wrap section narrow">
    <h1>Volunteer with us</h1>
    <p class="lead">Tell us a little about yourself and we will reply within a week with ways to help.</p>

    <form class="form" method="post">
        <label for="name">Full name</label>
        <input id="name" name="name" type="text" required />

        <label for="email">Email</label>
        <input id="email" name="email" type="email" required />

        <label for="area">How would you like to help?</label>
        <select id="area" name="area">
            <option>Events</option>
            <option>Fundraising</option>
            <option>Photography and writing</option>
            <option>Field visits</option>
        </select>

        <label for="message">Anything else we should know?</label>
        <textarea id="message" name="message" rows="4"></textarea>

        <button class="btn" type="submit">Send my details</button>
    </form>
</section>
