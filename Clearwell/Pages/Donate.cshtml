@page
@model Clearwell.Pages.DonateModel
@{ ViewData["Title"] = "Donate"; }

<section class="wrap section narrow">
    <h1>Donate</h1>
    <p class="lead">$50 gives one child clean water at school for a year. This is a demo, so no payment is taken.</p>

    <form class="form" method="post">
        <fieldset>
            <legend>Choose an amount</legend>
            <label><input type="radio" name="amount" value="25" /> $25</label>
            <label><input type="radio" name="amount" value="50" checked /> $50</label>
            <label><input type="radio" name="amount" value="100" /> $100</label>
            <label><input type="radio" name="amount" value="other" /> Other</label>
        </fieldset>

        <label for="name">Full name</label>
        <input id="name" name="name" type="text" required />

        <label for="email">Email</label>
        <input id="email" name="email" type="email" required />

        <button class="btn" type="submit">Complete demo donation</button>
    </form>
</section>
